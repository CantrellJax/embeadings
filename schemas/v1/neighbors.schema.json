{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DyrtyJax/embeadings/main/schemas/v1/neighbors.schema.json",
  "title": "emBEADings neighbors report, schema version 1",
  "type": "object",
  "required": ["schema_version", "report_type", "policy", "snapshot", "model", "cache", "issue", "neighbors"],
  "properties": {
    "schema_version": { "const": 1 },
    "report_type": { "const": "neighbors" },
    "policy": { "$ref": "#/$defs/policy" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "model": { "$ref": "#/$defs/model" },
    "cache": { "$ref": "#/$defs/cache" },
    "issue": { "$ref": "#/$defs/issue" },
    "neighbors": { "type": "array", "items": { "$ref": "#/$defs/neighbor" } },
    "score_baseline": { "$ref": "#/$defs/score-baseline" },
    "dropped": { "$ref": "#/$defs/dropped" }
  },
  "additionalProperties": true,
  "$defs": {
    "text-claim": {
      "type": "object",
      "required": ["issue_id", "related_issue_id", "kind"],
      "properties": {
        "issue_id": { "type": "string", "minLength": 1 },
        "related_issue_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "duplicate-of",
            "superseded-by",
            "absorbed-by",
            "fixed-by",
            "supersedes",
            "absorbs",
            "continued-in",
            "mention"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["read_only", "tracker_mutation_allowed", "advisory", "notice"],
      "properties": {
        "read_only": { "const": true },
        "tracker_mutation_allowed": { "const": false },
        "advisory": { "const": true },
        "notice": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": ["workspace_id", "beads_version"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "beads_version": { "type": ["string", "null"], "minLength": 1 },
        "tracker_name": { "enum": ["beads", "linear"] },
        "tracker_version": { "type": "string", "minLength": 1 },
        "workspace_path": { "type": ["string", "null"] },
        "relation_diagnostics": { "type": ["object", "null"] },
        "source_revision": { "type": ["string", "null"] },
        "source_divergence_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "dependency_structure",
              "issue_identity",
              "issue_type",
              "priority",
              "record_count",
              "status",
              "update_marker"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["model_id", "model_revision"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "cache": {
      "type": "object",
      "properties": {
        "hits": { "type": "integer", "minimum": 0 },
        "misses": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": ["integer", "null"] },
        "labels": { "type": "array", "items": { "type": "string" } },
        "parent_id": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "assignee": {
          "type": ["string", "null"],
          "description": "Assignee recorded by the tracker, when there is one."
        },
        "updated_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "score-baseline": {
      "type": "object",
      "description": "Percentiles of the seed's similarity to every record in scope; scores near p90 are the neighbourhood, not a match.",
      "required": ["population"],
      "properties": {
        "population": { "type": "integer", "minimum": 0 },
        "p50": { "type": "number" },
        "p90": { "type": "number" },
        "p99": { "type": "number" }
      },
      "additionalProperties": false
    },
    "dropped": {
      "type": "object",
      "description": "Ranked records skipped before --limit was reached, by filter.",
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "sibling": { "type": "integer", "minimum": 0 },
        "soft_link": { "type": "integer", "minimum": 0 },
        "structural_link": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "neighbor": {
      "allOf": [
        { "$ref": "#/$defs/issue" },
        {
          "type": "object",
          "required": ["similarity"],
          "properties": {
            "similarity": {
              "type": "number",
              "minimum": -1,
              "maximum": 1,
              "description": "Cosine similarity, -1..1. Model- and corpus-specific: compare with score_baseline, not a fixed cutoff."
            },
            "rank": {
              "type": "integer",
              "minimum": 1,
              "description": "Position among the seed's ranked neighbors before any filter (1 is nearest)."
            },
            "reverse_rank": {
              "type": "integer",
              "minimum": 1,
              "description": "Where the seed ranks among this neighbor's own neighbors; small on both sides is the strongest signal."
            },
            "structural_context": {
              "type": "string",
              "description": "Recorded parent or dependency relationship between seed and neighbor, or 'none recorded'."
            },
            "text_claims": {
              "type": "array",
              "items": { "$ref": "#/$defs/text-claim" },
              "description": "Lineage claims either record makes about the other in prose (duplicate of, folded into, ...)."
            },
            "guards": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Triage flags: label:<owner label>, in-progress-assigned, keyword:<word>. Needs a human before any fold or close."
            }
          }
        }
      ]
    }
  }
}
